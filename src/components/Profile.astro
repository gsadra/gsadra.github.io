---
import SocialLinks from './SocialLinks.astro';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<aside
  class:list={['profile', { 'profile--with-photo': Boolean(profile.photo) }]}
  aria-labelledby="profile-name"
>
  {
    profile.photo && (
      <figure class="profile__figure">
        {/* Real portrait: drop the file in /public/images and update `photo` + `photoAlt` in src/data/profile.ts. */}
        <img
          src={profile.photo}
          alt={profile.photoAlt}
          width="520"
          height="640"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        {import.meta.env.DEV && profile.photo.endsWith('.svg') && (
          <figcaption class="profile__hint">
            Placeholder: add your portrait as <code>public/images/profile.webp</code>.
          </figcaption>
        )}
      </figure>
    )
  }

  <div class="profile__identity">
    <h1 id="profile-name" class="profile__name">{profile.name}</h1>
    <p class="profile__role">{profile.title}</p>

    {
      profile.location && (
        <p class="profile__location">
          <Icon name="pin" size={14} />
          <span>{profile.location}</span>
        </p>
      )
    }
  </div>

  <div class="profile__links">
    <SocialLinks variant="stacked" />
  </div>

  <p class="profile__contact">
    <a href="/contact/">
      Get in touch
      <span class="profile__contact-arrow" aria-hidden="true">→</span>
    </a>
  </p>
</aside>

<style>
  .profile {
    min-width: 0;
    align-self: start;
  }

  /* On tall-enough desktop viewports the profile stays in view while the
     introduction and sections scroll beside it. */
  @media (min-width: 901px) and (min-height: 760px) {
    .profile {
      position: sticky;
      top: 1.75rem;
    }
  }

  .profile__figure {
    margin: 0;
  }

  .profile__figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 13 / 16;
    object-fit: cover;
    object-position: center 22%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background-color: var(--surface);
  }

  .profile__hint {
    margin-top: 0.55rem;
    font-size: var(--fs-2xs);
    line-height: 1.45;
    color: var(--muted);
  }

  .profile__hint code {
    font-family: var(--font-mono);
    font-size: 0.95em;
  }

  .profile__identity {
    margin-top: 1.2rem;
  }

  .profile__name {
    font-size: clamp(1.625rem, 1.45rem + 0.55vw, 1.875rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .profile__role {
    margin-top: 0.45rem;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--text);
  }

  .profile__location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.55rem;
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .profile__location :global(svg) {
    flex: none;
  }

  .profile__links {
    margin-top: 1.35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }

  .profile__contact {
    margin-top: 0.9rem;
    font-size: var(--fs-sm);
  }

  .profile__contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 500;
    text-decoration: none;
  }

  .profile__contact a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .profile__contact-arrow {
    transition: transform var(--duration) var(--ease);
  }

  .profile__contact a:hover .profile__contact-arrow {
    transform: translateX(2px);
  }

  /* Tablet: the sidebar becomes a compact profile card above the content. */
  @media (max-width: 900px) {
    .profile {
      padding-bottom: 1.75rem;
      border-bottom: 1px solid var(--border);
    }

    .profile--with-photo {
      display: grid;
      grid-template-columns: 128px minmax(0, 1fr);
      column-gap: 1.5rem;
      row-gap: 0.85rem;
      align-items: start;
    }

    .profile--with-photo .profile__figure {
      grid-column: 1;
      grid-row: 1 / span 2;
      width: 128px;
    }

    .profile--with-photo .profile__identity {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      margin-top: 0;
    }

    .profile--with-photo .profile__links {
      grid-column: 2;
      grid-row: 2;
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    .profile--with-photo .profile__contact {
      grid-column: 1 / -1;
      grid-row: 3;
      margin-top: 0;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border);
    }

    .profile__links :global(.social--stacked) {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.15rem 1rem;
    }
  }

  /* Mobile: portrait and identity share a row, with links below. */
  @media (max-width: 640px) {
    .profile--with-photo {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1rem;
      row-gap: 0.85rem;
      align-items: start;
    }

    .profile--with-photo .profile__figure {
      grid-column: 1;
      grid-row: 1;
      width: clamp(104px, 30vw, 128px);
    }

    .profile--with-photo .profile__identity {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      margin-top: 0;
    }

    .profile__name {
      font-size: clamp(1.35rem, 1.25rem + 0.5vw, 1.55rem);
    }

    .profile__role {
      margin-top: 0.3rem;
      font-size: var(--fs-xs);
    }

    .profile__location {
      margin-top: 0.4rem;
      font-size: var(--fs-2xs);
    }

    .profile--with-photo .profile__links {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 0;
      padding-top: 0.85rem;
      border-top: 1px solid var(--border);
    }

    .profile__links :global(.social--stacked a) {
      font-size: var(--fs-xs);
    }

    .profile--with-photo .profile__contact {
      grid-column: 1 / -1;
      grid-row: 3;
      margin-top: 0.7rem;
      padding-top: 0;
      border-top: 0;
    }

    .profile__contact {
      font-size: var(--fs-xs);
    }
  }
</style>
