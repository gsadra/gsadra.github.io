---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isoDate, readingTime } from '../../utils/dates';
import { tagHref } from '../../data/blog';
import {
  absoluteUrl,
  blogPostingNode,
  breadcrumbListNode,
  pageUrl,
  siteRoot,
} from '../../utils/seo';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags } = post.data;

const site = Astro.site ?? new URL(Astro.url.origin);
const root = siteRoot(site);
const canonical = pageUrl(Astro.url.pathname, site);
const published = isoDate(date);

const jsonLd = [
  blogPostingNode({
    root,
    url: canonical,
    headline: title,
    description,
    datePublished: published,
    tags: [...tags],
  }),
  // Matches the breadcrumb shown above the post title.
  breadcrumbListNode(canonical, [
    { name: 'Blog', url: absoluteUrl('/blog/', site) },
    { name: title, url: canonical },
  ]),
];
---

<BaseLayout
  title={`${title} | Sadra Gholami`}
  description={description}
  jsonLd={jsonLd}
  ogType="article"
  article={{ publishedTime: published, tags }}
>
  <article class="post">
    <header class="post-head">
      <div class="container--reading">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/blog/">Blog</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
          <span class="breadcrumb__current" aria-current="page">{title}</span>
        </nav>

        <h1 class="post-head__title">{title}</h1>
        <p class="lede post-head__desc">{description}</p>

        <div class="post-head__meta">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          <span class="meta__dot" aria-hidden="true"></span>
          <span>{readingTime(post.body)} min read</span>
        </div>

        {
          tags.length > 0 && (
            <ul class="tag-list post-head__tags" role="list">
              {tags.map((tag) => (
                <li class="tag">
                  <a href={tagHref(tag)}>{tag}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="container--reading">
      <div class="prose post-body">
        <Content />
      </div>

      <footer class="post-foot">
        <a href="/blog/">
          <span aria-hidden="true">←</span>
          All writing
        </a>
        <a href="/blog/rss.xml">RSS feed</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post-head {
    padding-block: clamp(2rem, 1.6rem + 2vw, 3rem) clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-xs);
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .breadcrumb__sep {
    color: var(--border-strong);
  }

  .breadcrumb__current {
    color: var(--muted);
  }

  .post-head__title {
    max-width: 24ch;
    font-size: clamp(1.875rem, 1.5rem + 1.6vw, 2.375rem);
  }

  .post-head__desc {
    margin-top: 0.9rem;
    max-width: 60ch;
    color: var(--muted);
    font-size: var(--fs-base);
    line-height: 1.65;
  }

  .post-head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 1.15rem;
    font-size: var(--fs-sm);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .post-head__tags {
    margin-top: 0.9rem;
  }

  .post-body {
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--border);
  }

  .post-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    border-top: 1px solid var(--border);
    padding-block: 1.5rem 4rem;
    font-size: var(--fs-sm);
  }

  .post-foot a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    text-decoration: none;
  }

  .post-foot a:hover {
    color: var(--accent);
  }

  @media (max-width: 520px) {
    .breadcrumb__sep,
    .breadcrumb__current {
      display: none;
    }
  }
</style>
