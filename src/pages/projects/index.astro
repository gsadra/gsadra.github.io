---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectCategories } from '../../data/taxonomy';

const projects = await getCollection('projects');

const groups = projectCategories
  .map((category) => ({
    category,
    projects: projects
      .filter((project) => project.data.category === category)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
  }))
  .filter((group) => group.projects.length > 0);

const description =
  'Technical projects by Sadra Gholami in machine learning, operations research, optimization, and Python development.';
---

<PageLayout
  title="Projects | Sadra Gholami"
  description={description}
  heading="Projects"
  width="default"
  lede="Applied work in machine learning, optimization, and data analysis. Each project page documents the problem, the method, and what the results do and do not establish."
>
  <div class="project-groups">
    {
      groups.map((group) => (
        <section class="group" aria-labelledby={`group-${group.category.replace(/\s+/g, '-').toLowerCase()}`}>
          <div class="group__head">
            <h2
              class="group__title"
              id={`group-${group.category.replace(/\s+/g, '-').toLowerCase()}`}
            >
              {group.category}
            </h2>
            <span class="group__count">
              {group.projects.length} {group.projects.length === 1 ? 'project' : 'projects'}
            </span>
          </div>

          <div class="group__list">
            {group.projects.map((project) => (
              <ProjectCard project={project} showCategory={false} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</PageLayout>

<style>
  .project-groups {
    display: grid;
    gap: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
    padding-bottom: 4rem;
    max-width: 900px;
  }

  .group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  .group__title {
    font-size: var(--fs-lg);
  }

  .group__count {
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
