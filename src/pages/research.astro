---
import PageLayout from '../layouts/PageLayout.astro';
import ResearchInterests from '../components/ResearchInterests.astro';
import Icon from '../components/Icon.astro';
import { currentResearch, researchMethods } from '../data/research';

const description =
  'Research interests and current work by Sadra Gholami: machine learning for workload scheduling, operations research, and optimization.';
---

<PageLayout
  title="Research | Sadra Gholami"
  description={description}
  heading="Research"
  lede="My interests sit between optimization and statistical learning: using data to make better decisions, and using theory to keep those decisions defensible."
>
  <div class="page-stack">
    <section class="block" aria-labelledby="overview">
      <h2 id="overview">Overview</h2>
      <div class="prose">
        <p>
          Operations research provides the language for constrained decision problems —
          objectives, feasibility, and bounds. Machine learning provides a way to
          estimate the quantities those problems depend on, and increasingly, to
          propose the decisions themselves. My work explores where the two meet,
          with scheduling as the main application area.
        </p>
        <p>
          The emphasis is on methods that can be evaluated honestly: a clear
          baseline, a reproducible experimental setup, and results reported with
          their limitations rather than as a single headline number.
        </p>
      </div>
    </section>

    <section class="block" aria-labelledby="interests">
      <h2 id="interests">Research interests</h2>
      <ResearchInterests ruled={false} />
    </section>

    <section class="block" aria-labelledby="current">
      <h2 id="current">Current research</h2>

      <div class="current">
        <div class="current__head">
          <h3 class="current__title">{currentResearch.title}</h3>
          <span class="status status--in-progress">{currentResearch.status}</span>
        </div>

        <p class="current__summary">{currentResearch.summary}</p>

        <h4 class="current__subhead">Research questions</h4>
        <ol class="questions">
          {currentResearch.questions.map((question) => <li>{question}</li>)}
        </ol>

        <h4 class="current__subhead">Methods</h4>
        <ul class="methods" role="list">
          {currentResearch.methods.map((method) => <li>{method}</li>)}
        </ul>

        <h4 class="current__subhead">Planned scope</h4>
        <ul class="methods" role="list">
          {currentResearch.scope.map((item) => <li>{item}</li>)}
        </ul>

        <a class="current__link" href="/projects/cluster-scheduling/">
          Project notes and status
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .page-stack {
    display: grid;
    gap: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
    padding-bottom: 4rem;
  }

  .block h2 {
    font-size: var(--fs-xl);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.25rem;
  }

  .current {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.15rem, 1rem + 0.8vw, 1.6rem);
    background-color: var(--surface);
  }

  .current__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .current__title {
    font-size: var(--fs-lg);
  }

  .current__summary {
    margin-top: 0.7rem;
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: var(--text);
    max-width: 64ch;
  }

  .current__subhead {
    margin-top: 1.4rem;
    margin-bottom: 0.5rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--muted);
  }

  .questions {
    margin: 0;
    padding-left: 1.1rem;
    font-size: var(--fs-sm);
    line-height: 1.65;
  }

  .questions li::marker {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .questions li + li {
    margin-top: 0.4rem;
  }

  .methods {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
    max-width: 62ch;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--muted);
  }

  .methods li {
    position: relative;
    padding-left: 1rem;
  }

  .methods li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 5px;
    height: 1px;
    background-color: var(--muted);
  }

  .current__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.5rem;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .current__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .tools {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .tools__group {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .tools__group:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .tools dt {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text);
  }

  .tools dd {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  @media (max-width: 520px) {
    .tools__group {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
