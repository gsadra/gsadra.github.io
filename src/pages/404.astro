---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Sadra Gholami"
  description="The requested page could not be found."
  noindex
>
  <div class="container--reading not-found">
    <p class="eyebrow">404</p>
    <h1 class="not-found__title">Page not found</h1>
    <p class="lede not-found__text">
      The page you were looking for does not exist, or it may have moved. If you
      followed a link here, it may be out of date.
    </p>
    <div class="not-found__links">
      <a href="/">Home</a>
      <span aria-hidden="true">·</span>
      <a href="/research/">Research</a>
      <span aria-hidden="true">·</span>
      <a href="/projects/">Projects</a>
      <span aria-hidden="true">·</span>
      <a href="/blog/">Blog</a>
      <span aria-hidden="true">·</span>
      <a href="/contact/">Contact</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(4rem, 3rem + 6vw, 7rem) 6rem;
  }

  .not-found__title {
    margin-top: 0.75rem;
    font-size: clamp(1.875rem, 1.5rem + 1.8vw, 2.5rem);
  }

  .not-found__text {
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--fs-base);
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    font-size: var(--fs-sm);
  }

  .not-found__links a {
    text-decoration: none;
    font-weight: 500;
  }

  .not-found__links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .not-found__links span {
    color: var(--border-strong);
  }
</style>
