---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  kicker?: string;
  lede?: string;
  width?: 'default' | 'reading';
  /** Set when the page itself is about the site owner (home, about). */
  aboutPerson?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  heading,
  kicker,
  lede,
  width = 'reading',
  aboutPerson = false,
  jsonLd,
} = Astro.props;

const containerClass = width === 'default' ? 'container' : 'container--reading';
---

<BaseLayout
  title={title}
  description={description}
  aboutPerson={aboutPerson}
  jsonLd={jsonLd}
>
  <header class="page-header">
    <div class={containerClass}>
      {kicker && <p class="eyebrow page-header__kicker">{kicker}</p>}
      <h1 class="page-header__title">{heading}</h1>
      {lede && <p class="lede page-header__lede">{lede}</p>}
    </div>
  </header>

  <div class={containerClass}>
    <slot />
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 2rem + 2.4vw, 4rem) clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
  }

  .page-header__kicker {
    margin-bottom: 0.75rem;
  }

  .page-header__title {
    max-width: 18ch;
  }

  .page-header__lede {
    margin-top: 1.1rem;
    max-width: 62ch;
    color: var(--muted);
    font-size: var(--fs-base);
    line-height: 1.65;
  }

  .page-header__lede :global(a) {
    color: var(--accent);
  }
</style>
