---
import '../styles/variables.css';
import '../styles/typography.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, siteMeta } from '../data/profile';
import {
  OG_IMAGE_HEIGHT,
  OG_IMAGE_PATH,
  OG_IMAGE_WIDTH,
  absoluteUrl,
  pageUrl,
  personNode,
  siteRoot,
  structuredData,
  twitterHandle,
  webPageNode,
  webSiteNode,
  type JsonLdNode,
} from '../utils/seo';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Set when the page itself is about the site owner (home, about). */
  aboutPerson?: boolean;
  /** Extra schema nodes appended to this page's JSON-LD graph. */
  jsonLd?: JsonLdNode | JsonLdNode[];
  /** Open Graph object type; blog posts use `article`. */
  ogType?: 'website' | 'article';
  article?: {
    /** ISO date (YYYY-MM-DD) of publication. */
    publishedTime?: string;
    tags?: string[];
  };
}

const {
  title,
  description,
  noindex = false,
  aboutPerson = false,
  jsonLd,
  ogType = 'website',
  article,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const root = siteRoot(site);
const canonical = pageUrl(Astro.url.pathname, site);
const ogImage = absoluteUrl(OG_IMAGE_PATH, site);
const ogImageAlt = `${profile.name} — ${profile.title}`;
const twitterCreator = profile.social.x
  ? twitterHandle(profile.social.x)
  : undefined;

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const extraNodes: JsonLdNode[] = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

// One `@graph` per page keeps the Person, WebSite and WebPage entities linked
// instead of repeating them as disconnected objects. Noindex pages carry no
// structured data.
const jsonLdDocument = noindex
  ? undefined
  : structuredData([
      personNode(root),
      webSiteNode(root),
      webPageNode({
        root,
        url: canonical,
        name: title,
        description,
        aboutPerson,
      }),
      ...extraNodes,
    ]);

const jsonLdHtml = jsonLdDocument
  ? JSON.stringify(jsonLdDocument).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang={siteMeta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} — Blog`}
      href={new URL('/blog/rss.xml', site).href}
    />
    <meta name="theme-color" content="#ffffff" />

    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      article?.publishedTime && (
        <meta property="article:published_time" content={article.publishedTime} />
      )
    }
    {ogType === 'article' && <meta property="article:author" content={root} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="generator" content={Astro.generator} />

    {jsonLdHtml && <script type="application/ld+json" set:html={jsonLdHtml} />}
  </head>

  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
